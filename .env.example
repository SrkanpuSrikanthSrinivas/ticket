# --- Neon Postgres (reuse the Pustaka Mela project or make a new DB) ---
DATABASE_URL="postgres://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/mkant?sslmode=require"

# --- Braintree (same account as the Pustaka Mela store) ---
BT_ENV="sandbox"                 # switch to "production" for the real event
BT_MERCHANT_ID="your_merchant_id"
BT_PUBLIC_KEY="your_public_key"
BT_PRIVATE_KEY="your_private_key"

# --- Ticket QR signing. Generate once: openssl rand -base64 32 ---
TICKET_SECRET="change-me-to-a-long-random-string"

# --- Email (ticket delivery). Resend shown; swap freely. ---
RESEND_API_KEY="re_xxx"
TICKET_FROM="MKANT Tickets <tickets@mkant.org>"
PUBLIC_BASE_URL="https://tickets.mkant.org"

# --- Simple staff gate for check-in/redeem screens ---
STAFF_PIN="4729"

# --- Which site is allowed to embed the buyer flow in an iframe ---
EMBED_ORIGIN="https://mkant.org"
